# ===== PRODUCTION ENVIRONMENT =====
# Use this template for deployment. Never commit real secrets to git!

# Database (Use MongoDB Atlas - https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fashionhub?retryWrites=true&w=majority
PORT=3000

# Security - Generate strong random strings!
JWT_SECRET=your-super-secret-jwt-key-generate-random-string-here
SESSION_SECRET=your-super-secret-session-key-generate-random-string-here
ADMIN_PASSWORD=change-this-to-a-strong-password

# OAuth (Optional - Get from Google & Facebook developer consoles)
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

FACEBOOK_APP_ID=your-production-facebook-app-id
FACEBOOK_APP_SECRET=your-production-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/auth/facebook/callback

# Hugging Face API Key (for AI features)
HF_API_KEY=hf_your_production_key_here
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_RAG_MODEL=google/flan-t5-large

# Optional: Email notifications for support tickets
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Fashion Hub Support <support@fashionhub.com>

# Node environment
NODE_ENV=production
