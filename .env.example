# Example environment variables for Fashion Hub Backend
# Copy this file to .env and fill values before running locally

# MongoDB connection string. For Docker Compose, you can use the built-in mongo service:
# MONGODB_URI="mongodb://mongo:27017/fashionhub"
MONGODB_URI="mongodb://mongo:27017/fashionhub"

# Server port
PORT=3000

# Admin password (change in production)
ADMIN_PASSWORD=admin123

# JSON Web Token secret
JWT_SECRET=change_this_secret

# Other optional envs
# NODE_ENV=development
# E2E_DIAGNOSTICS=true
# Copy to .env and fill with real values
MONGODB_URI=mongodb://localhost/fashionhub
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-secret
PORT=3000