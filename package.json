{
  "name": "zenrix-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ext js,html,css --delay 250ms server.js",
    "reindex:knowledge": "node scripts/reindex_knowledge.js",
    "test:ui": "echo \"No UI tests configured\"",
    "test:ui:strict": "echo \"No strict UI tests configured\"",
    "test:a11y": "echo \"No accessibility tests configured\"",
    "test:star-visual": "echo \"No visual tests configured\"",
    "test:admin:all": "echo \"No admin e2e tests configured\"",
    "e2e": "node scripts/e2e_admin_flows.js",
    "e2e:admin": "node scripts/e2e_admin_full.js",
    "test:chatbot:ticket": "node scripts/e2e_chatbot_ticket_offer_check.js",
    "test:kb:toggle": "node scripts/e2e_knowledge_feature_toggle_check.js",
    "build:tailwind:site": "tailwindcss -c tailwind.site.config.js -i Frontend/css/tailwind-site.input.css -o Frontend/css/tailwind-site.css --minify",
    "build:tailwind:admin": "tailwindcss -c tailwind.admin.config.js -i Frontend/css/tailwind-admin.input.css -o Frontend/css/tailwind-admin.css --minify",
    "build:tailwind": "npm run build:tailwind:site && npm run build:tailwind:admin"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "axe-core": "^4.11.0",
    "nodemon": "^3.0.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.34.0",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "qs": "6.14.1"
  }
}
